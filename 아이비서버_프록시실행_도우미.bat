@echo off
title iwinv(ivy) 서버 네이버 프록시 실행 도우미
color 0F

:MENU
cls
echo ======================================================================
echo   참좋은부동산 - iwinv(ivy) 서버 네이버 프록시 실행 도우미
echo ======================================================================
echo.
echo [서버 정보] IP: 49.247.132.147  (계정: root)
echo.
echo ----------------------------------------------------------------------
echo 1: [권장] SSH로 서버 접속하기 (화면이 닫히지 않고 서버 터미널에 머뭅니다)
echo 2: 최신 ivy_proxy.py 파일을 서버로 복사(전송)하기
echo 3: 종료
echo ======================================================================
echo.
echo [안내] 접속 후 서버 화면에 아래 명령어를 복사해서 마우스 우클릭으로 붙여넣으세요:
echo    nohup python3 ivy_proxy.py > proxy.log 2>&1 &
echo.
set /p sel="번호를 누르고 엔터를 치세요 (1/2/3): "

if "%sel%"=="1" goto DO_SSH
if "%sel%"=="2" goto DO_SCP
if "%sel%"=="3" goto END
goto MENU

:DO_SCP
echo.
echo ======================================================================
echo [ivy_proxy.py 파일 전송 중...]
echo 서버 비밀번호를 입력하고 엔터를 치세요:
echo ======================================================================
scp ivy_proxy.py root@49.247.132.147:~/
echo.
echo ----------------------------------------------------------------------
echo 전송 완료! 아무 키나 누르면 메뉴로 돌아갑니다.
echo ----------------------------------------------------------------------
pause
goto MENU

:DO_SSH
echo.
echo ======================================================================
echo [서버 접속 중...] 서버 비밀번호를 입력하고 엔터를 치세요:
echo ======================================================================
echo.
ssh root@49.247.132.147
echo.
echo ======================================================================
echo SSH 접속이 종료되었습니다.
echo ======================================================================
pause
goto MENU

:END
exit

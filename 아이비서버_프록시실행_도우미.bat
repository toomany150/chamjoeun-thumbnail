@echo off
chcp 65001 > nul
title iwinv(ivy) 서버 네이버 프록시 실행 도우미
color 0F

:MENU
cls
echo ======================================================================
echo   참좋은부동산 - iwinv(ivy) 서버 네이버 프록시 실행 도우미
echo ======================================================================
echo.
echo [서버 정보] IP: 49.247.132.147  (사용자: root)
echo.
echo 💡 [중요] 서버에 접속한 후, 아래 명령어를 복사(마우스 우클릭)해서 붙여넣으세요:
echo.
echo    nohup python3 ivy_proxy.py > proxy.log 2>&1 &
echo.
echo ----------------------------------------------------------------------
echo 1: SSH로 서버 접속하기 (화면이 꺼지지 않고 서버에 머뭅니다)
echo 2: [추천] 내 컴퓨터의 최신 ivy_proxy.py 파일을 서버로 복사(전송)하기
echo 3: 종료
echo ======================================================================
echo.
set /p sel="번호를 누르고 엔터를 치세요 (1/2/3): "

if "%sel%"=="1" goto DO_SSH
if "%sel%"=="2" goto DO_SCP
if "%sel%"=="3" goto END
goto MENU

:DO_SCP
echo.
echo ======================================================================
echo [ivy_proxy.py 파일 전송 중...]
echo 서버 비밀번호를 입력하고 엔터를 치세요:
echo ======================================================================
scp ivy_proxy.py root@49.247.132.147:~/
echo.
echo ----------------------------------------------------------------------
echo 전송이 완료되었습니다! 이제 1번을 눌러 서버에 접속하세요.
echo ----------------------------------------------------------------------
pause
goto MENU

:DO_SSH
echo.
echo ======================================================================
echo [서버 접속 중...] 서버 비밀번호를 입력하고 엔터를 치세요:
echo ======================================================================
echo.
ssh root@49.247.132.147
echo.
echo ======================================================================
echo SSH 접속이 종료되었습니다.
echo ======================================================================
pause
goto MENU

:END
exit
